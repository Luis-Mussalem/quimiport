{
  "name": "quimiport",
  "version": "0.2.0",
  "description": "API de gestão de cargas químicas portuárias",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "author": "Luis Otavio Mussalem Santos",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
