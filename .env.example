# Banco de dados (usado pelo docker compose)
POSTGRES_USER=quimiport
POSTGRES_PASSWORD=quimiport
POSTGRES_DB=quimiport
POSTGRES_PORT=5433

# Conexão da aplicação com o banco
DATABASE_URL="postgresql://quimiport:quimiport@localhost:5433/quimiport?schema=public"

# Schema separado para os testes de integração do banco (não apaga os dados de desenvolvimento)
TEST_DATABASE_URL="postgresql://quimiport:quimiport@localhost:5433/quimiport?schema=test"

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
